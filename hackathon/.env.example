# Copy to ../.env (repo root) and replace KEYTIME with your MongoDB connection string.
# While MongoURI is KEYTIME or unset, the API uses local JSON files in hackathon/server/data/.
MongoURI=KEYTIME
MongoDB=hackathon
PORT=3001
# Render API origin, no trailing slash. Leave empty for local dev.
# Example: https://nku-api.onrender.com
VITE_API_URL=
# Comma-separated emails that are always developer accounts. Example: you@nku.edu
DEVELOPER_EMAILS=
