# Copy to .env and replace KEYTIME with your MongoDB connection string.
# MongoDB Atlas: Database Access -> Connect -> Drivers -> copy the string.
MongoURI=KEYTIME
MongoDB=hackathon
PORT=3001
# Hosted site origin, no trailing slash. Example: https://nku-app.onrender.com
CLIENT_ORIGIN=
# Comma-separated emails that are always developer accounts. Example: you@nku.edu
DEVELOPER_EMAILS=
